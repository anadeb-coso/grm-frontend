{
  "expo": {
    "name": "MGP TG",
    "description": "L’application MGP est une application de gestion et de suivi des plaintes collectées sur le terrain. Elle nous permet d’avoir une vue globale des incidents ou problèmes liés aux projets pilotés par ANADEB. L'application MGP nous facilite l'échange entre nos collaborateurs pour qu'ils soient à l'écoute des incidents survenus sur le terrain.",
    "slug": "grm-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "owner": "sigexpoanadeb",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anadeb.grmapp",
      "versionCode": 20
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-av",
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "9bfe59c1-ca12-4be9-9241-950dddc0ed69"
      }
    }
  }
}
