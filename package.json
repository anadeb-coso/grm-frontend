    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "postinstall": "patch-package",
    "start:clean": "react-native start --reset-cache",
    "clean:android": "cd android && ./gradlew clean && rm -rf ./app/build && cd .. && yarn cache clean && rm -rf node_modules/.cache",
